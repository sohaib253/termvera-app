# Backend (apps/api)
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://tenderguard:tenderguard@localhost:5432/tenderguard
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]

# AI provider — required for POST /api/projects/{id}/analysis on real
# (non-demo) projects. Do not send real tender/bid content to any provider
# until data-handling configuration and customer authorization are in
# place, per docs/security.md. The "Try the sample project" demo does not
# need this — it uses precomputed sample data, not a live AI call.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Analysis engines. "brain" (default) is the built-in rule-based engine:
# no API key, no model, no GPU. Alternatives: "claude" (needs
# ANTHROPIC_API_KEY) for both, or "ollama" for ClauseRisk.
TENDERGUARD_AI_PROVIDER=brain
CLAUSERISK_AI_PROVIDER=brain
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct

# Frontend (apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
